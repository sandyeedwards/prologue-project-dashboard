# Application
APP_BASE_URL=http://localhost:3000
APP_ENV=development

# Database
# The two URLs may be identical for local development.
DATABASE_URL=postgresql://prologue:REPLACE_WITH_PASSWORD@localhost:5432/prologue_dashboard
DIRECT_DATABASE_URL=postgresql://prologue:REPLACE_WITH_PASSWORD@localhost:5432/prologue_dashboard

# Teamwork workspace
TEAMWORK_SITE_URL=https://YOUR_WORKSPACE.teamwork.com

# Teamwork OAuth
TEAMWORK_CLIENT_ID=REPLACE_WITH_TEAMWORK_CLIENT_ID
TEAMWORK_CLIENT_SECRET=REPLACE_WITH_TEAMWORK_CLIENT_SECRET
TEAMWORK_REDIRECT_URI=http://localhost:3000/api/teamwork/oauth/callback

# Application security
TEAMWORK_SETUP_KEY=REPLACE_WITH_RANDOM_SETUP_KEY
TEAMWORK_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_ENCRYPTION_KEY

# Initial administrators
# Separate multiple addresses with commas.
DASHBOARD_BOOTSTRAP_ADMIN_EMAILS=your.name@prologuesystems.com
